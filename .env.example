# Copy to .env and adjust. All optional — defaults are in backend/app/config.py.

# AOI_DATA_DIR=./data
# AOI_OUTPUTS_DIR=./outputs
# AOI_DB_PATH=./data/db/inspection.sqlite

# --- image quality gate (calibrate to your camera + lighting) ---
# AOI_QUALITY_BLUR_MIN=20
# AOI_QUALITY_CONTRAST_MIN=14
# AOI_QUALITY_BRIGHTNESS_MIN=35
# AOI_QUALITY_BRIGHTNESS_MAX=230

# --- board detection / crop (stage A) ---
# AOI_DETECT_ENABLED=true
# AOI_DETECT_MIN_AREA_FRAC=0.10
# AOI_DETECT_ASPECT_TOLERANCE=0.35

# --- alignment ---
# AOI_ALIGN_MIN_INLIERS=22
# AOI_ALIGN_MAX_ERROR_PX=4.0
# AOI_ALIGN_ECC_FALLBACK=true

# --- registration-trust guard ---
# AOI_DECISION_MIN_BOARD_SSIM=0.62

# --- region comparison defaults (per-region overrides live in regions.json) ---
# AOI_REGION_POSITION_TOL_PX=8.0
# AOI_REGION_ROTATION_TOL_DEG=8.0
# AOI_REGION_MISSING_CORR=0.45
# AOI_REGION_COLOR_DELTA_MAX=38.0          # CIELAB drift => wrong-colour anomaly
# AOI_REGION_ANOMALY_MIN_BOARD_SSIM=0.80   # below this SSIM, suppress visual/colour anomalies

# --- decision engine ---
# AOI_DECISION_MIN_CONFIDENCE=0.60

# --- pixel -> mm (0 disables mm reporting) ---
# AOI_MM_PER_PX=0.0

# --- optional YOLO component detector (milestone 3). Unset => "MODEL NOT CONFIGURED" ---
# Needs: pip install -r backend/requirements-ml.txt  + a trained model (scripts/train_yolo.py)
# AOI_YOLO_MODEL_PATH=./models/component_detector.pt
# AOI_YOLO_CONFIDENCE=0.35
# AOI_YOLO_MATCH_IOU=0.10
# AOI_YOLO_FLAG_UNEXPECTED=false

# --- CORS (frontend dev origin) ---
# AOI_CORS_ORIGINS=["http://localhost:5173"]

# --- physical station (ESP32 over Wi-Fi). See hardware/README.md ---
# Serve the API on the LAN too:  uvicorn app.main:app --host 0.0.0.0 --port 8000
# AOI_STATION_ENABLED=true
# AOI_STATION_SOURCE=http://192.168.1.42:8080/video   # single camera: index or stream URL
# AOI_STATION_REFERENCE_ID=PCB_MODEL_001              # default: active reference
# AOI_STATION_REJECT_STATUSES=["DEFECTIVE"]           # statuses that fire the reject gate
#
# OR multi-camera (2-4 views inspected at once, verdict = worst view):
# AOI_STATION_VIEWS=[{"name":"front","source":"http://192.168.1.42:8080/video","reference_id":"BOX_FRONT"},{"name":"top","source":"0","reference_id":"BOX_TOP"}]
